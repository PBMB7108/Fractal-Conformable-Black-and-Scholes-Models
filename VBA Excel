Sub Calcular()
    Dim ws As Worksheet
    Dim wsCat As Worksheet
    Dim rngVars As Range, rngRestr As Range
    Dim fila As Range
    Dim colResumen As Long
    Dim maxIter As Integer
    Dim tolerancia As Double
    Dim vars As String
    
    ' --- Optimización: desactivar eventos, pantalla y cálculo
    Application.EnableEvents = False
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    
    On Error GoTo SalidaSegura
    
    Set ws = Sheets("Resumen")
    Set wsCat = Sheets("Catalogo")
    Set rngVars = wsCat.Range("tblVariables")
    Set rngRestr = wsCat.Range("tblRestricciones")
    
    maxIter = ws.Range("B25").Value
    tolerancia = ws.Range("B26").Value
    
    ' Recorre las columnas definidas
    For colResumen = ws.Range("B18").Value To ws.Range("B19").Value
        
        SolverReset
        
        ' Construir lista de variables dinámicamente
        vars = ""
        For Each fila In rngVars.Rows
            If fila.Cells(1, 1).Value = colResumen Then
                If vars = "" Then
                    vars = fila.Cells(1, 3).Value
                Else
                    vars = vars & "," & fila.Cells(1, 3).Value
                End If
            End If
        Next fila
        
        ' Configuración del Solver
        SolverOk SetCell:=ws.Cells(17, colResumen).Address, _
                 MaxMinVal:=3, _
                 ValueOf:=ws.Cells(10, colResumen).Value, _
                 ByChange:=vars, _
                 Engine:=1, EngineDesc:="GRG Nonlinear"
        
        ' Agregar restricciones dinámicamente
        For Each fila In rngRestr.Rows
            If fila.Cells(1, 1).Value = colResumen Then
                SolverAdd CellRef:=fila.Cells(1, 3).Value, _
                          Relation:=fila.Cells(1, 4).Value, _
                          FormulaText:=fila.Cells(1, 5).Value
            End If
        Next fila
        
        ' Ejecuta Solver para esa columna
        Resultados ws, maxIter, tolerancia, colResumen
    Next colResumen
    
    ' Copiar resultados
    CopiarResultados ws
           
    MsgBox "Listo"
    
SalidaSegura:

    ' --- Restaurar configuraciones ---
    Application.EnableEvents = True
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    
    ' Ajustar ancho de columnas en Resultados (después de recalcular MAP)
    Dim destino As Worksheet
    Dim lastCol As Long
    Set destino = Sheets("Resultados")
    lastCol = destino.Cells(2, destino.Columns.Count).End(xlToLeft).Column
    destino.Range(destino.Columns(2), destino.Columns(lastCol)).AutoFit
    
    ' Congelar paneles entre fila 2 y 3
    destino.Activate
    destino.Range("A3").Select
    ActiveWindow.FreezePanes = True

End Sub

Private Sub Resultados(ws As Worksheet, maxIter As Integer, tolerancia As Double, colResumen As Long)
    Dim i As Integer
    Dim valorObjetivo As Double
    Dim valorActual As Variant
    Dim resultado As String
    
    valorObjetivo = ws.Cells(10, colResumen).Value
    valorActual = ws.Cells(17, colResumen).Value
    
    If IsError(valorActual) Then
        resultado = "Error"
    ElseIf Abs(valorActual - valorObjetivo) <= tolerancia Then
        resultado = "0"
    Else
        For i = 1 To maxIter
            SolverSolve UserFinish:=True
            valorActual = ws.Cells(17, colResumen).Value
            If IsError(valorActual) Then
                resultado = "Error"
                Exit For
            End If
            If Abs(valorActual - valorObjetivo) <= tolerancia Then
                resultado = CStr(i)
                Exit For
            End If
        Next i
        If resultado = "" Then resultado = "No"
    End If
    
    ' Registrar resultado en la fila 23 de la misma columna
    ws.Cells(23, colResumen).Value = resultado
    
    ' Colorear la celda de fila 22 (nombre del modelo) según resultado
    If resultado = "Error" Or resultado = "No" Then
        ws.Cells(22, colResumen).Interior.Color = RGB(164, 0, 0)
        ws.Cells(22, colResumen).Font.Color = vbWhite
    Else
        ws.Cells(22, colResumen).Interior.Color = RGB(78, 169, 46)
        ws.Cells(22, colResumen).Font.Color = vbWhite
    End If
End Sub

Private Sub CopiarResultados(ws As Worksheet)
    Dim destino As Worksheet
    Dim ultimaFila As Long
    Dim compania As String
    Dim grupo As Long
    Dim col As Long
    Dim rangoOrigen As Range
    Dim datos As Variant
    Dim elemento As String
    Dim ultimaCol As Long
    Dim encabezados As Variant
    Dim rngEncabezados As Range
    Dim nm As Name
    Dim formulaRef As String
       
    
    ' Crear hoja "Resultados" si no existe
    On Error Resume Next
    Set destino = Sheets("Resultados")
    If destino Is Nothing Then
        Set destino = Sheets.Add(After:=Sheets("Resumen"))
        destino.Name = "Resultados"
        
        ' Encabezados: FechaHora en B2, Compañía en C2 y los de columna J transpuestos en D2 en adelante
        destino.Range("B2").Value = "FechaHora"
        destino.Range("C2").Value = "Compañía"
        destino.Range("D2").Value = "Grupo"
        
        encabezados = Application.Transpose(ws.Range(ws.Range("B21").Value & ":" & ws.Range("C21").Value).Value)
        destino.Range("E2").Resize(1, UBound(encabezados)).Value = encabezados
        
        ' --- Formato de los encabezados ---
        Set rngEncabezados = destino.Range("B2").Resize(1, 3 + UBound(encabezados)) ' B2 hasta última columna

        With rngEncabezados
            .Font.Bold = True  ' Negritas
            .HorizontalAlignment = xlCenter  ' Centrado horizontal
            .Interior.Color = RGB(25, 107, 36) ' Color de fondo (ejemplo: Verde obscuro)
            .Font.Color = RGB(255, 255, 255) 'Color de la letra (ejemplo: blanco)
'            .Borders.LineStyle = xlContinuous ' Opcional: bordes alrededor
        End With

    End If
    On Error GoTo 0
    
    ' Obtener compañía y grupo
    compania = ws.Range("B13").Value
    grupo = ws.Range("B15").Value
    
    ' Recorrer columnas K a AS (11 a 45)
    For col = ws.Range("B18").Value To ws.Range("B19").Value
        
        ' Validar celda en fila 23 y que no esté ya marcado como Copiado en fila 24
        If ws.Cells(23, col).Value <> "Error" And ws.Cells(23, col).Value <> "No" And ws.Cells(24, col).Value <> "Copiado" Then
            
            ' El "Elemento" es el encabezado de la columna J correspondiente
            elemento = ws.Cells(col - 1, 10).Value
            
            ' Agregar nueva fila en Resultados
            ultimaFila = destino.Cells(destino.Rows.Count, 3).End(xlUp).Row
            If ultimaFila < 3 Then ultimaFila = 2
            ultimaFila = ultimaFila + 1
            
            Set rangoOrigen = ws.Range(ws.Cells(2, col), ws.Cells(19, col))
            datos = Application.Transpose(rangoOrigen.Value)
            
            destino.Cells(ultimaFila, 2).Value = Now
            destino.Cells(ultimaFila, 3).Value = compania
            destino.Cells(ultimaFila, 4).Value = grupo
            destino.Cells(ultimaFila, 5).Resize(1, UBound(datos)).Value = datos
            
            ' Marcar como copiado en fila 24 de Resumen
            ws.Cells(24, col).Value = "Copiado"
            With ws.Cells(24, col)
                .HorizontalAlignment = xlCenter   ' Centrado horizontal
'                .VerticalAlignment = xlCenter     ' Centrado vertical (opcional)
'                .Font.Bold = True                 ' Negritas (opcional)
'                .Interior.Color = RGB(255, 255, 200) ' Color de fondo (ejemplo: amarillo claro)
            End With
            
        End If
    Next col
    
 Call LimpiarDuplicados
 
     ' Crear Columna Origen
    ultimaCol = destino.Cells(2, destino.Columns.Count).End(xlToLeft).Column
    If Application.WorksheetFunction.CountIf(destino.Rows(2), "Origen") = 0 Then
    destino.Cells(2, ultimaCol + 1).Value = "Origen"
    ultimaCol = ultimaCol + 1
    Else
        ultimaCol = destino.Rows(2).Find("Origen", LookAt:=xlWhole).Column
    End If
     
    ' --- Formato de los encabezados ---
    Set rngEncabezados = destino.Range("B2", destino.Cells(2, ultimaCol)) ' B2 hasta la última columna real
    
    With rngEncabezados
        .Font.Bold = True
        .HorizontalAlignment = xlCenter
        .Interior.Color = RGB(25, 107, 36)
        .Font.Color = RGB(255, 255, 255)
    End With
       
    ' Insertar fórmula MAP en fila 3 (desbordará automáticamente)
    destino.Cells(3, ultimaCol).Formula2 = _
        "=MAP(Compañía,LAMBDA(a,XLOOKUP(a,CHOOSECOLS(Origen,1),CHOOSECOLS(Origen,2),"""",0,1)))"

    ' Crear/actualizar nombre dinámico Compañía
    formulaRef = "=OFFSET(Resultados!$C$3,0,0,COUNTA(Resultados!$C:$C)-1,1)"
    
    On Error Resume Next
    Set nm = ThisWorkbook.Names("Compañía")
    On Error GoTo 0
    
    If nm Is Nothing Then
        ThisWorkbook.Names.Add Name:="Compañía", RefersTo:=formulaRef
    Else
        nm.RefersTo = formulaRef
    End If
        
End Sub

Sub LimpiarDuplicados()
    Dim destino As Worksheet
    Dim ultimaFila As Long
    Dim ultimaCol As Long
    
    Set destino = Sheets("Resultados")
    ultimaFila = destino.Cells(destino.Rows.Count, 2).End(xlUp).Row
    ultimaCol = destino.Cells(2, destino.Columns.Count).End(xlToLeft).Column
    
    ' Ordenar por Compañía (C), Elemento (D) y FechaHora (B) descendente
    destino.Sort.SortFields.Clear
    destino.Sort.SortFields.Add Key:=destino.Range("C3:C" & ultimaFila), _
        SortOn:=xlSortOnValues, Order:=xlAscending, DataOption:=xlSortNormal
    destino.Sort.SortFields.Add Key:=destino.Range("D3:D" & ultimaFila), _
        SortOn:=xlSortOnValues, Order:=xlAscending, DataOption:=xlSortNormal
    destino.Sort.SortFields.Add Key:=destino.Range("H3:H" & ultimaFila), _
        SortOn:=xlSortOnValues, Order:=xlAscending, DataOption:=xlSortNormal
    destino.Sort.SortFields.Add Key:=destino.Range("B3:B" & ultimaFila), _
        SortOn:=xlSortOnValues, Order:=xlDescending, DataOption:=xlSortNormal
    
    With destino.Sort
        .SetRange destino.Range(destino.Cells(2, 2), destino.Cells(ultimaFila, ultimaCol))
        .Header = xlYes
        .Apply
    End With
    
    ' Eliminar duplicados dejando la fila más reciente (por compañía+elemento)
    destino.Range(destino.Cells(2, 2), destino.Cells(ultimaFila, ultimaCol)).RemoveDuplicates _
        Columns:=Array(2, 3, 7, 4), Header:=xlYes
End Sub
